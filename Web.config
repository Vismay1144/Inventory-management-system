<?xml version="1.0" encoding="utf-8"?>
<!--
  Stock & Inventory Management System - Web Configuration
  Configured for IIS / IIS Express Localhost Intranet PC Hosting
  Target Runtime: ASP.NET 4.8 / 4.7.2 / 4.5.2
-->
<configuration>
  <connectionStrings>
    <!--
      MySQL Connection String managed via SQLyog
      Adjust Server, Port, Uid, and Pwd according to your local MySQL instance.
      Default MySQL root password on local machines is often blank or 'root' / 'admin'.
    -->
    <add name="InventoryDbConn"
         connectionString="Server=localhost;Port=3306;Database=InventoryDB;Uid=root;Pwd=;AllowZeroDateTime=True;ConvertZeroDateTime=True;SslMode=none;CharSet=utf8mb4;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Transactions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
    </compilation>

    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" maxRequestLength="10240" />

    <customErrors mode="RemoteOnly" defaultRedirect="Default.aspx">
    </customErrors>

    <pages controlRenderingCompatibilityVersion="4.0" enableViewState="true">
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Data" />
        <add namespace="System.Web" />
        <add namespace="System.Web.UI" />
      </namespaces>
    </pages>

    <sessionState mode="InProc" timeout="60" />
    <globalization culture="en-US" uiCulture="en-US" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
